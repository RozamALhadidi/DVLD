# =================================================================
# Visual Studio / .NET Framework standard .gitignore
# =================================================================

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache/options directory
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# Except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/

# Test files
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.TestResults

# Visual Studio Profiler
*.psess
*.vsp
*.vspx
*.sap

# Publish profiles (user-specific)
*.pubxml.user
*.publishproj

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Windows image file caches
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Folder config file
Desktop.ini

# Crash Reports
*.mdmp